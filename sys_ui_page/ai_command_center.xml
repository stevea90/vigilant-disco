<?xml version="1.0" encoding="UTF-8"?>
<record_update table="sys_ui_page">
  <sys_ui_page action="INSERT_OR_UPDATE">
    <sys_id>up1a2b3c4d5e6f7a8b9c0d1e2f3a4b5da</sys_id>
    <name>x_snc_ai_sdlc_ai_command_center</name>
    <description>AI Command Center — developer dashboard showing AI automation status for all Story AI Manifests. Navigate to x_snc_ai_sdlc_ai_command_center.do</description>
    <direct>true</direct>
    <category>general</category>
    <sys_class_name>sys_ui_page</sys_class_name>
    <sys_created_by>admin</sys_created_by>
    <sys_mod_count>0</sys_mod_count>
    <sys_name>x_snc_ai_sdlc_ai_command_center</sys_name>
    <sys_package display_value="SDLC AI Orchestrator" source="x_snc_ai_sdlc">b1a2c3d4e5f6a7b8c9d0e1f2a3b4c5d6</sys_package>
    <sys_scope display_value="SDLC AI Orchestrator">b1a2c3d4e5f6a7b8c9d0e1f2a3b4c5d6</sys_scope>
    <client_script><![CDATA[/* AI Command Center — client-side helpers */

function refreshPage() {
    window.location.reload();
}

function openManifest(sysId) {
    window.open('/x_snc_ai_sdlc_story_manifest.do?sys_id=' + sysId, '_blank');
}

function openStory(sysId) {
    window.open('/rm_story.do?sys_id=' + sysId, '_blank');
}

function openATFSuite(sysId) {
    if (!sysId || sysId === '') return;
    window.open('/sys_atf_suite.do?sys_id=' + sysId, '_blank');
}

function filterByStatus(status) {
    var rows = document.querySelectorAll('tr.manifest-row');
    rows.forEach(function(row) {
        if (status === 'all' || row.dataset.status === status) {
            row.style.display = '';
        } else {
            row.style.display = 'none';
        }
    });
    document.querySelectorAll('.filter-btn').forEach(function(btn) {
        btn.classList.remove('active');
    });
    document.querySelector('.filter-btn[data-status="' + status + '"]').classList.add('active');
}
]]></client_script>
    <processing_script><![CDATA[/* Server-side processing — runs before HTML render */
var manifestHelper = new x_snc_ai_sdlc.ManifestHelper();

/* Aggregate stats for summary bar */
var statsJson = manifestHelper.getDashboardStats();
var stats     = JSON.parse(statsJson);

/* Recent manifests for grid */
var rowsJson = manifestHelper.getRecentManifests();
var rows     = JSON.parse(rowsJson);

/* Provider info for footer */
var provider = gs.getProperty('x_snc_ai_sdlc.llm_provider', 'anthropic');
var model    = provider === 'openai'
    ? gs.getProperty('x_snc_ai_sdlc.openai_model', 'gpt-4o')
    : gs.getProperty('x_snc_ai_sdlc.anthropic_model', 'claude-3-5-sonnet-20241022');
]]></processing_script>
    <html><![CDATA[<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
<style type="text/css">
  .ai-cc-wrapper        { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; padding: 20px; max-width: 1400px; margin: 0 auto; }
  .ai-cc-header         { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px; }
  .ai-cc-title          { font-size: 24px; font-weight: 700; color: #1d2635; margin: 0; }
  .ai-cc-subtitle       { color: #6b7280; font-size: 13px; margin-top: 4px; }

  /* Stats bar */
  .ai-stats-bar         { display: flex; gap: 16px; margin-bottom: 24px; flex-wrap: wrap; }
  .ai-stat-card         { background: #fff; border: 1px solid #e5e7eb; border-radius: 8px; padding: 16px 20px; min-width: 140px; flex: 1; }
  .ai-stat-card .label  { font-size: 12px; color: #6b7280; text-transform: uppercase; letter-spacing: 0.05em; }
  .ai-stat-card .value  { font-size: 28px; font-weight: 700; margin-top: 4px; }
  .ai-stat-total        { border-left: 4px solid #6366f1; }
  .ai-stat-completed    { border-left: 4px solid #22c55e; }
  .ai-stat-failed       { border-left: 4px solid #ef4444; }
  .ai-stat-running      { border-left: 4px solid #f59e0b; }
  .ai-stat-pending      { border-left: 4px solid #9ca3af; }

  /* Filter bar */
  .ai-filter-bar        { margin-bottom: 16px; display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
  .filter-btn           { padding: 5px 14px; border-radius: 20px; border: 1px solid #d1d5db; background: #fff; cursor: pointer; font-size: 13px; color: #374151; }
  .filter-btn:hover     { background: #f3f4f6; }
  .filter-btn.active    { background: #6366f1; color: #fff; border-color: #6366f1; }
  .btn-refresh          { margin-left: auto; padding: 6px 16px; background: #6366f1; color: #fff; border: none; border-radius: 6px; cursor: pointer; font-size: 13px; }
  .btn-refresh:hover    { background: #4f46e5; }

  /* Grid */
  .ai-grid-table        { width: 100%; border-collapse: collapse; background: #fff; border: 1px solid #e5e7eb; border-radius: 8px; overflow: hidden; }
  .ai-grid-table thead  { background: #f9fafb; }
  .ai-grid-table th     { padding: 10px 14px; text-align: left; font-size: 12px; font-weight: 600; color: #6b7280; text-transform: uppercase; letter-spacing: 0.04em; border-bottom: 1px solid #e5e7eb; white-space: nowrap; }
  .ai-grid-table td     { padding: 10px 14px; font-size: 13px; color: #374151; border-bottom: 1px solid #f3f4f6; vertical-align: middle; }
  .ai-grid-table tr:last-child td { border-bottom: none; }
  .ai-grid-table tr.manifest-row:hover { background: #f9fafb; }

  /* Story link */
  .ai-link              { color: #6366f1; text-decoration: none; font-weight: 500; }
  .ai-link:hover        { text-decoration: underline; }

  /* Status badge */
  .badge                { display: inline-block; padding: 2px 10px; border-radius: 12px; font-size: 11px; font-weight: 600; text-transform: capitalize; }
  .badge-completed      { background: #dcfce7; color: #166534; }
  .badge-failed         { background: #fee2e2; color: #991b1b; }
  .badge-running        { background: #fef9c3; color: #854d0e; }
  .badge-pending        { background: #f3f4f6; color: #374151; }
  .badge-partial        { background: #fef3c7; color: #92400e; }

  /* Check / cross icons */
  .check                { color: #22c55e; font-weight: 700; }
  .cross                { color: #d1d5db; }

  /* Token count */
  .tokens               { font-variant-numeric: tabular-nums; color: #6b7280; font-size: 12px; }

  /* Footer */
  .ai-footer            { margin-top: 24px; padding: 16px; background: #f9fafb; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 12px; color: #6b7280; display: flex; gap: 24px; flex-wrap: wrap; align-items: center; }
  .ai-footer a          { color: #6366f1; text-decoration: none; }
  .ai-footer a:hover    { text-decoration: underline; }

  /* Empty state */
  .ai-empty             { text-align: center; padding: 48px 24px; color: #9ca3af; }
  .ai-empty h3          { font-size: 18px; color: #6b7280; margin-bottom: 8px; }
</style>

<div class="ai-cc-wrapper">

  <!-- ── Header ─────────────────────────────────────────────────── -->
  <div class="ai-cc-header">
    <div>
      <h1 class="ai-cc-title">AI Command Center</h1>
      <div class="ai-cc-subtitle">SDLC AI Orchestrator — Story Automation Dashboard</div>
    </div>
  </div>

  <!-- ── Stats Bar ──────────────────────────────────────────────── -->
  <g:evaluate>
    var totalVal     = stats.total     || 0;
    var completedVal = stats.completed || 0;
    var failedVal    = stats.failed    || 0;
    var runningVal   = stats.running   || 0;
    var pendingVal   = stats.pending   || 0;
    var partialVal   = stats.partial   || 0;
  </g:evaluate>
  <div class="ai-stats-bar">
    <div class="ai-stat-card ai-stat-total">
      <div class="label">Total Manifests</div>
      <div class="value">${totalVal}</div>
    </div>
    <div class="ai-stat-card ai-stat-completed">
      <div class="label">Completed</div>
      <div class="value" style="color:#22c55e;">${completedVal}</div>
    </div>
    <div class="ai-stat-card ai-stat-failed">
      <div class="label">Failed</div>
      <div class="value" style="color:#ef4444;">${failedVal}</div>
    </div>
    <div class="ai-stat-card ai-stat-running">
      <div class="label">Running</div>
      <div class="value" style="color:#f59e0b;">${runningVal}</div>
    </div>
    <div class="ai-stat-card ai-stat-pending">
      <div class="label">Pending</div>
      <div class="value" style="color:#9ca3af;">${pendingVal}</div>
    </div>
    <g:evaluate>var partialVal2 = stats.partial || 0;</g:evaluate>
    <j:if test="${partialVal2 > 0}">
    <div class="ai-stat-card" style="border-left:4px solid #f59e0b;">
      <div class="label">Partial</div>
      <div class="value" style="color:#f59e0b;">${partialVal2}</div>
    </div>
    </j:if>
  </div>

  <!-- ── Filter Bar ─────────────────────────────────────────────── -->
  <div class="ai-filter-bar">
    <span style="font-size:13px;font-weight:600;color:#374151;">Filter:</span>
    <button class="filter-btn active" data-status="all"       onclick="filterByStatus('all')">All</button>
    <button class="filter-btn"        data-status="pending"   onclick="filterByStatus('pending')">Pending</button>
    <button class="filter-btn"        data-status="running"   onclick="filterByStatus('running')">Running</button>
    <button class="filter-btn"        data-status="completed" onclick="filterByStatus('completed')">Completed</button>
    <button class="filter-btn"        data-status="partial"   onclick="filterByStatus('partial')">Partial</button>
    <button class="filter-btn"        data-status="failed"    onclick="filterByStatus('failed')">Failed</button>
    <button class="btn-refresh"       onclick="refreshPage()">&#8635; Refresh</button>
  </div>

  <!-- ── Grid ───────────────────────────────────────────────────── -->
  <g:evaluate>var rowCount = rows.length;</g:evaluate>
  <j:if test="${rowCount == 0}">
    <div class="ai-empty">
      <h3>No Story AI Manifests Found</h3>
      <p>Manifests are created automatically when a Story is inserted, or when any AI action is triggered from an rm_story form.</p>
    </div>
  </j:if>

  <j:if test="${rowCount > 0}">
    <table class="ai-grid-table">
      <thead>
        <tr>
          <th>Story</th>
          <th>Status</th>
          <th title="Uplifted Story">Uplift</th>
          <th title="Generated Code">Code</th>
          <th title="Unit Tests">Tests</th>
          <th title="Stakeholder Steps">Steps</th>
          <th title="ATF Records">ATF</th>
          <th>Tokens</th>
          <th>Model</th>
          <th>Last Run By</th>
          <th>Updated</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <g:evaluate>
          for (var ri = 0; ri &lt; rows.length; ri++) {
              var row = rows[ri];
        </g:evaluate>
        <tr class="manifest-row" data-status="${row.status}">
          <td>
            <a class="ai-link" href="javascript:openStory('${row.story_sys_id}')">${row.story_display}</a>
          </td>
          <td>
            <span class="badge badge-${row.status}">${row.status}</span>
          </td>
          <td class="${row.has_uplift ? 'check' : 'cross'}">${row.has_uplift ? '&#10003;' : '&#8212;'}</td>
          <td class="${row.has_code ? 'check' : 'cross'}">${row.has_code ? '&#10003;' : '&#8212;'}</td>
          <td class="${row.has_unit_tests ? 'check' : 'cross'}">${row.has_unit_tests ? '&#10003;' : '&#8212;'}</td>
          <td class="${row.has_stakeholder_steps ? 'check' : 'cross'}">${row.has_stakeholder_steps ? '&#10003;' : '&#8212;'}</td>
          <td>
            <j:if test="${row.has_atf}">
              <a class="ai-link" href="javascript:openATFSuite('${row.atf_suite_id}')">&#10003; Suite</a>
            </j:if>
            <j:if test="${!row.has_atf}">
              <span class="cross">&#8212;</span>
            </j:if>
          </td>
          <td class="tokens">${row.tokens}</td>
          <td style="font-size:11px;color:#6b7280;max-width:140px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="${row.model}">${row.model}</td>
          <td style="white-space:nowrap;">${row.last_run_by}</td>
          <td style="font-size:12px;color:#9ca3af;white-space:nowrap;">${row.updated}</td>
          <td>
            <a class="ai-link" href="javascript:openManifest('${row.sys_id}')">View</a>
          </td>
        </tr>
        <g:evaluate>
          }
        </g:evaluate>
      </tbody>
    </table>
  </j:if>

  <!-- ── Footer ─────────────────────────────────────────────────── -->
  <div class="ai-footer">
    <span><strong>Provider:</strong> ${provider}</span>
    <span><strong>Model:</strong> ${model}</span>
    <a href="/sys_properties_list.do?sysparm_query=nameLIKEx_snc_ai_sdlc" target="_blank">&#9881; Configure Properties</a>
    <a href="/sys_rest_message_list.do?sysparm_query=name=AI LLM API" target="_blank">&#128279; REST Message Config</a>
    <a href="/x_snc_ai_sdlc_story_manifest_list.do" target="_blank">&#128196; All Manifests</a>
    <span style="margin-left:auto;color:#d1d5db;">SDLC AI Orchestrator v1.0.0</span>
  </div>

</div>
</j:jelly>
]]></html>
  </sys_ui_page>
</record_update>
